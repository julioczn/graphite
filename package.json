{
  "name": "graphite",
  "version": "0.16.0",
  "description": "Fast desktop client for 24 databases (SQL, NoSQL and cloud warehouses), with an AI assistant and an MCP server for your own agents.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5199 && VITE_DEV_SERVER_URL=http://localhost:5199 electron . --no-sandbox\"",
    "build": "vite build",
    "start": "vite build && electron . --no-sandbox",
    "dist": "vite build && node scripts/native-bindings.mjs linux x64 && electron-builder --linux AppImage deb --x64",
    "dist:deb": "vite build && node scripts/native-bindings.mjs linux x64 && electron-builder --linux deb --x64",
    "dist:mac": "vite build && node scripts/native-bindings.mjs darwin arm64 x64 && electron-builder --mac dmg zip --arm64 --x64",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "author": "Julio Zimmermann <julioczn@gmail.com>",
  "homepage": "https://julioczn.github.io/graphite/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julioczn/graphite.git"
  },
  "bugs": {
    "url": "https://github.com/julioczn/graphite/issues"
  },
  "keywords": [
    "sql",
    "database",
    "client",
    "sqlite",
    "postgresql",
    "mysql",
    "mariadb",
    "electron",
    "vue",
    "mcp",
    "ai"
  ],
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dagrejs/dagre": "^1.1.4",
    "@lezer/highlight": "^1.2.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "codemirror": "^6.0.2",
    "concurrently": "^9.2.5",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "vite": "^6.4.4",
    "vue": "^3.5.44",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@clickhouse/client": "1.25.0",
    "@duckdb/node-api": "1.5.6-r.2",
    "@libsql/client": "0.18.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "cassandra-driver": "4.10.0",
    "ioredis": "6.0.0",
    "mongodb": "7.8.0",
    "mysql2": "^3.24.6",
    "node-firebird": "2.21.0",
    "oracledb": "26.0.0",
    "pg": "^8.23.1",
    "ssh2": "1.17.0",
    "tedious": "20.3.9",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "productName": "Graphite",
  "build": {
    "appId": "dev.graphite.sqlclient",
    "productName": "Graphite",
    "files": [
      "dist/**",
      "electron/**",
      "shared/**",
      "package.json",
      "!node_modules/libsql/**",
      "!node_modules/@libsql/darwin-*/**",
      "!node_modules/@libsql/linux-*/**",
      "!node_modules/@libsql/win32-*/**",
      "!node_modules/oracledb/build/**",
      "!node_modules/@duckdb/node-bindings-*/**",
      "node_modules/@duckdb/node-bindings-${platform}-${arch}/**",
      "!node_modules/cpu-features/**",
      "!node_modules/nan/**",
      "!node_modules/ssh2/lib/protocol/crypto/build/**"
    ],
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "artifactName": "Graphite-${version}.${ext}",
      "synopsis": "Desktop client for 24 databases",
      "executableName": "graphite",
      "description": "Fast desktop client for 24 databases: PostgreSQL, MySQL, SQL Server, Oracle, SQLite, MongoDB, Redis, DynamoDB, ClickHouse and more."
    },
    "directories": {
      "output": "release"
    },
    "deb": {
      "packageName": "graphite",
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1"
      ],
      "artifactName": "${name}_${version}_${arch}.${ext}"
    },
    "rpm": {
      "packageName": "graphite",
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret",
        "alsa-lib",
        "mesa-libgbm"
      ],
      "artifactName": "${name}-${version}.x86_64.${ext}"
    },
    "pacman": {
      "packageName": "graphite-dbclient",
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libxss",
        "libxtst",
        "xdg-utils",
        "at-spi2-core",
        "util-linux-libs",
        "libsecret",
        "alsa-lib",
        "mesa"
      ],
      "artifactName": "graphite-dbclient-${version}-x86_64.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "Graphite-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "notarize": false,
      "identity": "-"
    },
    "dmg": {
      "artifactName": "Graphite-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "Graphite-${version}-win-${arch}.${ext}",
      "executableName": "Graphite"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Graphite",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Graphite-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/@duckdb/node-bindings-*/**"
    ]
  }
}
